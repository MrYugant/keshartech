# Copy to .env.local and fill in. Never commit real values.
# All variables are server-only (no NEXT_PUBLIC_ prefix) and never reach the browser.

# --- Enquiry storage (Supabase) ---
# Run supabase/schema.sql first. The anon key is sufficient because RLS only allows INSERT.
SUPABASE_URL=
SUPABASE_KEY=

# --- Email notification (Resend, https://resend.com) ---
RESEND_API_KEY=
# Verified sender, e.g. "Keshar Tech Website <website@keshartech.com>"
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries
CONTACT_TO_EMAIL=hello@keshartech.com
